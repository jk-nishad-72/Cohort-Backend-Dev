
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/login.css" />
</head>
<body>

    <form method="POST" action="/auth/login" novalidate>
        <h2>Login</h2>
        <div class="input-group">
            <label for="email">Email or Username </label>
            <input type="email" id="email" name="email" inputmode="email" autocomplete="email" placeholder="you@example.com or username" required>
        </div>
        <div class="input-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="current-password" placeholder="••••••••" required>
        </div>
        <button type="submit">Login</button>
    </form>

    <!-- Theme Toggle -->
    <button id="theme-toggle"
     style="position: fixed; top: 1rem; 
     right: 1rem; padding: 0.5rem 1rem; 
     border: none; border-radius: var(--radius);
        background: var(--accent-color); color: white;
         cursor: pointer; width: 3rem;">
        🌙
    </button>

    <script src="/script.js"></script>
</body>
</html>